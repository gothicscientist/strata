# Strata environment variables. Copy to `.env` and fill in. Never commit real secrets.
# Read by the API and worker (services/api/strata/config.py and the science modules) and by
# infra/docker-compose.yml. Web-app variables live in apps/web/.env.example.

# ---------------------------------------------------------------- runtime
# dev | test | prod. prod refuses to start without STRATA_DATA_KEY or with SQLite.
STRATA_ENV=dev
STRATA_LOG_LEVEL=INFO
# Root of data/ (examples/, derived/). Default: <repo>/data
STRATA_DATA_DIR=
# Reference artefacts (populations.parquet, coordinates/, pca/, snp_panel.parquet).
# Default: $STRATA_DATA_DIR/derived
STRATA_DERIVED_DIR=
# Precomputed examples. Default: $STRATA_DATA_DIR/examples
STRATA_EXAMPLES_DIR=
# Commit recorded in analysis provenance when .git is not present (e.g. in containers).
STRATA_GIT_SHA=

# ---------------------------------------------------------------- database
# Dev/test default: sqlite:///./strata-dev.db. Production: Postgres (Supabase), e.g.
# postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./strata-dev.db
STRATA_DB_ECHO=false
# docker-compose only: password of the bundled Postgres.
POSTGRES_PASSWORD=strata

# ---------------------------------------------------------------- encryption / secrets
# Key-encryption key (KEK) for per-dataset envelope encryption: base64 of 32 random bytes.
#   openssl rand -base64 32
# Losing it makes every stored dataset unreadable. Without it (dev only) an ephemeral key is
# generated per process and data is unreadable after restart.
STRATA_DATA_KEY=
# Comma-separated previous KEKs, still accepted for unwrapping during key rotation.
STRATA_DATA_KEY_PREVIOUS=
# HMAC secret for guest tokens. Default: derived from STRATA_DATA_KEY.
STRATA_GUEST_TOKEN_SECRET=

# ---------------------------------------------------------------- Supabase
# Project URL (https://<ref>.supabase.co). Enables JWKS discovery and issuer checks.
SUPABASE_URL=
# Legacy HS256 JWT secret (Settings -> API). Leave empty if the project uses asymmetric keys.
SUPABASE_JWT_SECRET=
# JWKS endpoint for RS256/ES256 tokens. Default: $SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Service-role key: server side only, needed for STRATA_STORAGE_BACKEND=supabase.
SUPABASE_SERVICE_ROLE_KEY=
# Where encrypted dataset blobs live: db (bytea column) | local (STRATA_STORAGE_DIR) | supabase
STRATA_STORAGE_BACKEND=db
STRATA_STORAGE_DIR=
STRATA_STORAGE_BUCKET=encrypted-datasets

# ---------------------------------------------------------------- research assistant (LLM)
# anthropic | openai | none. The assistant is disabled unless the selected provider has a key.
STRATA_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides (see services/api/strata/agent/providers.py)
STRATA_LLM_MODEL=
STRATA_OPENAI_MODEL=
STRATA_LLM_MAX_TOKENS=
STRATA_LLM_TIMEOUT_S=
STRATA_LLM_EFFORT=
STRATA_ANTHROPIC_FALLBACKS=
# Price override for cost accounting: "in,out[,cache_read,cache_write]" USD per Mtok.
STRATA_LLM_PRICE=
STRATA_AGENT_MAX_STEPS=
STRATA_AGENT_MAX_PARALLEL_TOOLS=
STRATA_AGENT_TOOL_TIMEOUT_S=
# RAG: optional dense retrieval (BM25 is always on). openai | voyage | empty to disable.
STRATA_EMBEDDINGS=
STRATA_EMBEDDING_MODEL=
VOYAGE_API_KEY=
STRATA_METHODS_DIR=

# ---------------------------------------------------------------- jobs / worker
# inline: run jobs inside the API request (dev, tests). queue: Postgres queue + worker.
STRATA_JOB_MODE=inline
STRATA_JOB_MAX_ATTEMPTS=3
STRATA_JOB_BACKOFF_BASE_S=5
STRATA_JOB_HEARTBEAT_S=10
STRATA_JOB_STALE_AFTER_S=120
STRATA_JOB_TIMEOUT_S=1800
STRATA_WORKER_POLL_S=1
STRATA_WORKER_CONCURRENCY=2
# Liveness file refreshed by the worker loop (used by the compose healthcheck).
STRATA_WORKER_HEALTH_FILE=

# ---------------------------------------------------------------- qpAdm (R + ADMIXTOOLS 2)
STRATA_RSCRIPT=
STRATA_R_DIR=
STRATA_QPADM_TIMEOUT=1800
# Reference f2 cache. Default: data/derived/f2/$STRATA_REFERENCE_VERSION if it exists.
STRATA_F2_DIR=
STRATA_REFERENCE_VERSION=strata-ref-v1

# ---------------------------------------------------------------- HTTP
# Comma-separated allowed browser origins (local web + Cloudflare Pages).
STRATA_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Trust CF-Connecting-IP / X-Forwarded-For for rate limiting (only behind a trusted proxy).
STRATA_TRUST_PROXY_HEADERS=false
STRATA_GUEST_TTL_HOURS=24
STRATA_MAX_UPLOAD_MB=64
# Token-bucket rate limits (per client IP; "expensive" = uploads, analyses, chat per user).
STRATA_RATE_LIMIT_PER_MINUTE=120
STRATA_RATE_LIMIT_BURST=60
STRATA_RATE_LIMIT_EXPENSIVE_PER_MINUTE=10

# ---------------------------------------------------------------- tests
# Optional: run Postgres-only tests (SKIP LOCKED concurrency, RLS migrations).
STRATA_TEST_POSTGRES_URL=
